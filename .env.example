# ─────────────────────────────────────────────────────────────────────────
# Flightdeck provider for Next.js Commerce — environment
#
# Copy to `.env.local` in your vercel/commerce fork, or set these in your
# Vercel project (Project → Settings → Environment Variables).
#
# The only SECRET here is FLIGHTDECK_STOREFRONT_TOKEN. All three are read
# in server code only (the provider and the checkout route) and none is
# prefixed NEXT_PUBLIC_ — nothing here reaches the browser bundle.
# ─────────────────────────────────────────────────────────────────────────

# ── REQUIRED ───────────────────────────────────────────────────────────────

# The commerce API origin your store reads catalog + places orders against.
FLIGHTDECK_API_URL="https://api.ruo.pro"

# The tenant THIS deployment serves. This is your store's tenant ref, issued
# when your store was provisioned.
FLIGHTDECK_TENANT="your-store-tenant-ref"

# The narrow, tenant-scoped storefront credential (`x-storefront-token`).
# SERVER-SIDE ONLY — it authorizes placing orders for your tenant. Rotate it
# any time from your merchant console; treat it like a password.
FLIGHTDECK_STOREFRONT_TOKEN="sft_replace_me"

# ── OPTIONAL (template branding) ───────────────────────────────────────────

COMPANY_NAME="dsco"
SITE_NAME="RUO Pro Demo"
